{
  "name": "backupjam",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r --filter './packages/*' test && pnpm --filter @backupjam/api test:unit",
    "test:e2e": "pnpm --filter @backupjam/api test:e2e",
    "typecheck": "pnpm -r typecheck",
    "i18n:check": "pnpm --filter @backupjam/i18n test",
    "i18n:arb": "pnpm --filter @backupjam/i18n export:arb",
    "tokens": "pnpm --filter @backupjam/design-tokens test",
    "db:migrate": "pnpm --filter @backupjam/api db:migrate",
    "openapi": "pnpm --filter @backupjam/api openapi:export",
    "dev:api": "pnpm --filter @backupjam/api dev",
    "dev:web": "pnpm --filter @backupjam/web dev",
    "dev:admin": "pnpm --filter @backupjam/admin dev"
  }
}

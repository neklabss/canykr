# ── BackUpJam API — example configuration. Copy to .env for local development. NEVER commit real secrets.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (web + admin).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Public URL of the web app (used for links in transactional emails).
APP_WEB_URL=http://localhost:3000
TRUST_PROXY=false

DATABASE_URL=postgres://backupjam:backupjam@localhost:5432/backupjam
REDIS_URL=redis://localhost:6379

# ≥ 32 random bytes. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-change-me
JWT_ISSUER=https://api.backupjam.local
JWT_AUDIENCE=backupjam-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# OAuth client IDs (comma-separated: web, iOS, Android). Empty = provider disabled.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Mail driver: 'console' is a MOCK that logs emails instead of sending them.
MAIL_DRIVER=console
MAIL_FROM="BackUpJam <no-reply@backupjam.local>"

# Current legal document versions users must accept at sign-up.
TERMS_VERSION=2026-11-01
PRIVACY_VERSION=2026-11-01

# Rate limits (requests per minute per IP).
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_AUTH=10

# scrypt cost (log2 N). 15 in production; lower only in tests.
PASSWORD_SCRYPT_LOG_N=15

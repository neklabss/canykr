  "info": {
    "title": "BackUpJam API",
    "description": "BackUpJam backend API. Errors use { error: { code, message, details? }, requestId }. Messages are localized via Accept-Language / X-BUJ-Locale / account preference.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ayla@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          },
          "displayName": {
            "type": "string",
            "example": "Ayla Drums"
          },
          "locale": {
            "type": "string",
            "description": "Explicit UI locale. Omit to follow the device language."
          },
          "countryCode": {
            "type": "string",
            "example": "TR"
          },
          "timeZone": {
            "type": "string",
            "example": "Europe/Istanbul"
          },
          "acceptTerms": {
            "type": "boolean",
            "description": "Must be true: user accepts the current Terms and Privacy Policy versions."
          },
          "marketingEmails": {
            "type": "boolean"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "musician",
                "band_member",
                "band_manager",
                "venue_owner",
                "venue_staff",
                "organizer",
                "booking_agent",
                "artist_manager",
                "sound_engineer",
                "lighting_technician",
                "music_teacher",
                "enthusiast",
                "customer"
              ]
            }
          },
          "deviceName": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "displayName",
          "acceptTerms"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "deviceName": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SocialLoginDto": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "description": "OIDC ID token obtained by the client from Google / Apple"
          },
          "nonce": {
            "type": "string",
            "description": "Raw nonce used for the request (Apple; recommended for Google)"
          },
          "displayName": {
            "type": "string",
            "description": "Apple only returns the name on first sign-in; the client forwards it."
          },
          "locale": {
            "type": "string"
          },
          "acceptTerms": {
            "type": "boolean",
            "description": "Required for first-time sign-up via social login."
          },
          "deviceName": {
            "type": "string"
          }
        },
        "required": [
          "idToken"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "TokenDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "required": [
          "token"
        ]
      },
      "EmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        },
        "required": [
          "token",
          "newPassword"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "username": {
            "type": "string",
            "pattern": "^[a-z0-9_.]{3,30}$"
          }
        }
      },
      "UpdatePreferencesDto": {
        "type": "object",
        "properties": {
          "locale": {
            "type": "object",
            "nullable": true,
            "description": "UI locale; null = follow device/browser"
          },
          "countryCode": {
            "type": "object",
            "nullable": true
          },
          "currencyCode": {
            "type": "object",
            "nullable": true
          },
          "timeZone": {
            "type": "object",
            "nullable": true
          },
          "theme": {
            "type": "string",
            "enum": [
              "system",
              "light",
              "dark"
            ]
          },
          "quietHoursStart": {
            "type": "object",
            "nullable": true,
            "example": "22:00"
          },
          "quietHoursEnd": {
            "type": "object",
            "nullable": true,
            "example": "08:00"
          }
        }
      },
      "CapabilitiesDto": {
        "type": "object",
        "properties": {
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "musician",
                "band_member",
                "band_manager",
                "venue_owner",
                "venue_staff",
                "organizer",
                "booking_agent",
                "artist_manager",
                "sound_engineer",
                "lighting_technician",
                "music_teacher",
                "enthusiast",
                "customer"
              ]
            }
          }
        },
        "required": [
          "capabilities"
        ]
      },
      "LatLngDto": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lng"
        ]
      },
      "OnboardingDto": {
        "type": "object",
        "properties": {
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "musician",
                "band_member",
                "band_manager",
                "venue_owner",
                "venue_staff",
                "organizer",
                "booking_agent",
                "artist_manager",
                "sound_engineer",
                "lighting_technician",
                "music_teacher",
                "enthusiast",
                "customer"
              ]
            }
          },
          "instruments": {
            "example": [
              "drums"
            ],
            "type": "array",
            "items": {
              "type": "array"
            }
          },
          "genres": {
            "example": [
              "jazz"
            ],
            "type": "array",
            "items": {
              "type": "array"
            }
          },
          "homeCountryCode": {
            "type": "object",
            "nullable": true
          },
          "homeCity": {
            "type": "object",
            "nullable": true
          },
          "location": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/LatLngDto"
              }
            ]
          },
          "availableForBookings": {
            "type": "object",
            "nullable": true
          },
          "discoverGoals": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "musicians",
                "jobs",
                "venues",
                "events"
              ]
            }
          },
          "languages": {
            "example": [
              "tr",
              "en"
            ],
            "type": "array",
            "items": {
              "type": "array"
            }
          },
          "travelCountryCodes": {
            "example": [
              "DE",
              "NL"
            ],
            "type": "array",
            "items": {
              "type": "array"
            }
          },
          "travelRadiusKm": {
            "type": "object",
            "nullable": true
          },
          "skippedSteps": {
            "type": "array",
            "items": {
              "type": "array"
            }
          },
          "complete": {
            "type": "boolean"
          }
        }
      },
      "ConsentDto": {
        "type": "object",
        "properties": {
          "consentType": {
            "type": "string",
            "enum": [
              "marketing_email",
              "marketing_push",
              "analytics",
              "ai_translation"
            ]
          },
          "granted": {
            "type": "boolean"
          }
        },
        "required": [
          "consentType",
          "granted"
        ]
      },
      "DeleteAccountDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "description": "Required when the account has a password"
          }
        }
      },
      "CreateOrganizationDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "band",
              "venue",
              "agency",
              "organizer",
              "company"
            ]
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,58}[a-z0-9]$"
          },
          "countryCode": {
            "type": "string"
          },
          "city": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "name",
          "slug"
        ]
      },
      "UpdateOrganizationDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "countryCode": {
            "type": "string"
          },
          "city": {
            "type": "string"
          }
        }
      },
      "InviteMemberDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "manager",
              "member",
              "staff"
            ]
          },
          "title": {
            "type": "string",
            "example": "Drummer"
          }
        },
        "required": [
          "email",
          "role"
        ]
      },
      "UpdateMemberDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "manager",
              "member",
              "staff"
            ]
          }
        },
        "required": [
          "role"
        ]
      },
      "SuspendDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "reason"
        ]
      },
      "FlagUpdateDto": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "rules": {
            "type": "object",
            "example": {
              "countries": [
                "TR"
              ]
            }
          }
        },
        "required": [
          "enabled"
        ]
      },
      "CountryUpdateDto": {
        "type": "object",
        "properties": {
          "launchStatus": {
            "type": "string",
            "enum": [
              "hidden",
              "beta",
              "live"
            ]
          },
          "paymentsEnabled": {
            "type": "boolean"
          },
          "paymentProvider": {
            "type": "object",
            "nullable": true
          }
        }
      },
      "GrantStaffDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "super_admin",
              "trust_safety",
              "finance_ops",
              "support",
              "localization_manager",
              "analyst"
            ]
          }
        },
        "required": [
          "userId",
          "role"
        ]
      }
    }
  }
}

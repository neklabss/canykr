{
  "name": "@backupjam/i18n",
  "version": "0.1.0",
  "private": true,
  "description": "BackUpJam shared localization: ICU message resources, locale negotiation, RTL, money/date formatting.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "locales"],
  "scripts": {
    "generate": "node scripts/build-resources.mjs",
    "build": "node scripts/build-resources.mjs && tsc -p tsconfig.build.json",
    "typecheck": "node scripts/build-resources.mjs && tsc -p tsconfig.json --noEmit",
    "test": "node scripts/build-resources.mjs && vitest run",
    "export:arb": "node scripts/export-arb.mjs"
  },
  "dependencies": {
    "intl-messageformat": "^10.7.16",
    "@formatjs/icu-messageformat-parser": "^2.11.2"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "@types/node": "^22.10.0"
  }
}

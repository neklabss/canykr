{
  "manifest_version": 3,
  "name": "NVI Form Yardımcısı",
  "version": "0.5.0",
  "description": "Müşteri bilgilerini NVI T.C. Kimlik No Doğrulama formuna aktarır. Yalnızca doldurur; güvenlik kodu ve sorgu görevliye aittir.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "scripting",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "https://tckimlik.nvi.gov.tr/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "side_panel": {
    "default_path": "src/panel.html"
  },
  "action": {
    "default_title": "NVI Form Yardımcısı",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "NVI Form Yardımcısı panelini aç"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
